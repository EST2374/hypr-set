/* ============================================================
   Hyprset — Dark Theme  (v5 · Tokyo Night)
   ============================================================
   bg-base:    #1a1b26   surface:    #24283b
   bg-raised:  #2a2e45   border:     #3b4261
   accent:     #7aa2f7   accent2:    #5d7bd4
   purple:     #bb9af7   cyan:       #7dcfff
   text:       #c0caf5   muted:      #565f89
   danger:     #f7768e   success:    #9ece6a
   ============================================================ */

/* ── Global ─────────────────────────────────────────────── */
QWidget {
    background-color: #1a1b26;
    color: #c0caf5;
    font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", "FiraCode Nerd Font", "Fira Code", "Cascadia Code", monospace;
    font-size: 13px;
}

QMainWindow {
    background-color: #1a1b26;
}

/* ── Labels ─────────────────────────────────────────────── */
QLabel {
    color: #a9b1d6;
    background: transparent;
    font-size: 12px;
    letter-spacing: 0.2px;
}

/* ── Push Buttons ───────────────────────────────────────── */
QPushButton {
    background-color: #24283b;
    color: #c0caf5;
    border: 1px solid #3b4261;
    border-radius: 7px;
    padding: 7px 18px;
    font-size: 13px;
    letter-spacing: 0.2px;
    outline: none;
    min-height: 30px;
}

QPushButton:hover {
    background-color: #2a2e45;
    color: #c0caf5;
    border-color: #7aa2f7;
}

QPushButton:pressed {
    background-color: #5d7bd4;
    color: #ffffff;
    border-color: #7aa2f7;
}

QPushButton:focus {
    border-color: #7aa2f7;
    outline: none;
}

QPushButton:disabled {
    background-color: #1a1b26;
    color: #3b4261;
    border-color: #24283b;
}

/* ── Primary / Apply button ─────────────────────────────── */
QPushButton#apply_button {
    background-color: #5d7bd4;
    color: #ffffff;
    border: 1px solid #7aa2f7;
    border-radius: 7px;
    font-weight: bold;
    letter-spacing: 0.4px;
    min-height: 36px;
}

QPushButton#apply_button:hover {
    background-color: #7aa2f7;
    border-color: #a9b8ff;
}

QPushButton#apply_button:pressed {
    background-color: #4a63b0;
    border-color: #7aa2f7;
}

/* ── Danger / Delete buttons ────────────────────────────── */
QPushButton#del_autostart_button,
QPushButton#del_env_button,
QPushButton#delete_keybind_button,
QPushButton#delete_movement_button,
QPushButton#delete_workspace_button,
QPushButton#delete_multimedia_button,
QPushButton#wifi_disconnect_button {
    background-color: #2a1520;
    color: #f7768e;
    border-color: #6b2d3e;
    border-radius: 7px;
}

QPushButton#del_autostart_button:hover,
QPushButton#del_env_button:hover,
QPushButton#delete_keybind_button:hover,
QPushButton#delete_movement_button:hover,
QPushButton#delete_workspace_button:hover,
QPushButton#delete_multimedia_button:hover,
QPushButton#wifi_disconnect_button:hover {
    background-color: #3d1a28;
    border-color: #f7768e;
    color: #ff9ea8;
}

QPushButton#del_autostart_button:pressed,
QPushButton#del_env_button:pressed,
QPushButton#delete_keybind_button:pressed,
QPushButton#delete_movement_button:pressed,
QPushButton#delete_workspace_button:pressed,
QPushButton#delete_multimedia_button:pressed,
QPushButton#wifi_disconnect_button:pressed {
    background-color: #521c2c;
}

/* ── Secondary action buttons (Set Default / Update) ────── */
QPushButton#set_default_look_button,
QPushButton#input_set_default_button,
QPushButton#set_default_monitor_button,
QPushButton#set_default_general_keybind_button,
QPushButton#set_default_movement_button,
QPushButton#set_default_workspace_button,
QPushButton#set_default_multimedia_button,
QPushButton#update_pushButton {
    min-width: 120px;
    min-height: 34px;
    background-color: #24283b;
    color: #c0caf5;
    border: 1px solid #3b4261;
    border-radius: 7px;
    font-weight: 500;
    letter-spacing: 0.3px;
    padding: 7px 18px;
}

QPushButton#set_default_look_button:hover,
QPushButton#input_set_default_button:hover,
QPushButton#set_default_monitor_button:hover,
QPushButton#set_default_general_keybind_button:hover,
QPushButton#set_default_movement_button:hover,
QPushButton#set_default_workspace_button:hover,
QPushButton#set_default_multimedia_button:hover,
QPushButton#update_pushButton:hover {
    background-color: #2a2e45;
    border-color: #7aa2f7;
    color: #a9b8ff;
}

/* ── Add buttons (inline actions) ───────────────────────── */
QPushButton#general_add_button,
QPushButton#movement_add_button,
QPushButton#workspace_add_button,
QPushButton#multimedia_add_button,
QPushButton#add_program_button,
QPushButton#add_script_button,
QPushButton#add_env_button,
QPushButton#wifi_refresh_button {
    background-color: #1c2240;
    color: #7aa2f7;
    border: 1px solid #2f3f70;
    border-radius: 7px;
    font-weight: 500;
}

QPushButton#general_add_button:hover,
QPushButton#movement_add_button:hover,
QPushButton#workspace_add_button:hover,
QPushButton#multimedia_add_button:hover,
QPushButton#add_program_button:hover,
QPushButton#add_script_button:hover,
QPushButton#add_env_button:hover,
QPushButton#wifi_refresh_button:hover {
    background-color: #243060;
    border-color: #7aa2f7;
    color: #a9b8ff;
}

QPushButton#general_add_button:pressed,
QPushButton#movement_add_button:pressed,
QPushButton#workspace_add_button:pressed,
QPushButton#multimedia_add_button:pressed,
QPushButton#add_program_button:pressed,
QPushButton#add_script_button:pressed,
QPushButton#add_env_button:pressed,
QPushButton#wifi_refresh_button:pressed {
    background-color: #2d3d7a;
    border-color: #7aa2f7;
}

/* ── Window Rule buttons ─────────────────────────────────── */
QPushButton#add_window_rule_button {
    background-color: #1c2240;
    color: #7aa2f7;
    border: 1px solid #2f3f70;
    border-radius: 7px;
    font-weight: 500;
}

QPushButton#add_window_rule_button:hover {
    background-color: #243060;
    border-color: #7aa2f7;
    color: #a9b8ff;
}

QPushButton#add_window_rule_button:pressed {
    background-color: #2d3d7a;
    border-color: #7aa2f7;
}

QPushButton#edit_window_rule_button {
    background-color: #24283b;
    color: #c0caf5;
    border: 1px solid #3b4261;
    border-radius: 7px;
    font-weight: 500;
}

QPushButton#edit_window_rule_button:hover {
    background-color: #2a2e45;
    border-color: #7aa2f7;
    color: #a9b8ff;
}

QPushButton#edit_window_rule_button:pressed {
    background-color: #2d3d7a;
    border-color: #7aa2f7;
}

QPushButton#delete_window_rule_button {
    background-color: #2a1520;
    color: #f7768e;
    border-color: #6b2d3e;
    border-radius: 7px;
}

QPushButton#delete_window_rule_button:hover {
    background-color: #3d1a28;
    border-color: #f7768e;
    color: #ff9ea8;
}

QPushButton#delete_window_rule_button:pressed {
    background-color: #521c2c;
}

/* ── File chooser buttons ────────────────────────────────── */
QPushButton#choose_config_file_button,
QPushButton#choose_hyprlock_button,
QPushButton#choose_hypersunset_button,
QPushButton#choose_hyperpaper_file_button,
QPushButton#choose_hypridle_button {
    background-color: #24283b;
    color: #c0caf5;
    border: 1px solid #3b4261;
    border-radius: 7px;
    font-weight: 500;
    padding: 6px 16px;
    min-height: 30px;
}

QPushButton#choose_config_file_button:hover,
QPushButton#choose_hyprlock_button:hover,
QPushButton#choose_hypersunset_button:hover,
QPushButton#choose_hyperpaper_file_button:hover,
QPushButton#choose_hypridle_button:hover {
    background-color: #2a2e45;
    border-color: #7aa2f7;
    color: #c0caf5;
}

QPushButton#choose_config_file_button:pressed,
QPushButton#choose_hyprlock_button:pressed,
QPushButton#choose_hypersunset_button:pressed,
QPushButton#choose_hyperpaper_file_button:pressed,
QPushButton#choose_hypridle_button:pressed {
    background-color: #2d3d7a;
    border-color: #7aa2f7;
}

/* ── Success / Install / Enable buttons ─────────────────── */
QPushButton#choose_folder_button,
QPushButton#install_button,
QPushButton#enable_button {
    background-color: #142018;
    color: #9ece6a;
    border: 1px solid #264d2e;
    border-radius: 7px;
    font-weight: 500;
}

QPushButton#choose_folder_button:hover,
QPushButton#install_button:hover,
QPushButton#enable_button:hover {
    background-color: #1e3326;
    border-color: #9ece6a;
    color: #b9e08a;
}

QPushButton#choose_folder_button:pressed,
QPushButton#install_button:pressed,
QPushButton#enable_button:pressed {
    background-color: #264535;
    border-color: #9ece6a;
}

/* ── Neutral-danger / Uninstall / Disable buttons ───────── */
QPushButton#uninstall_button,
QPushButton#disable_button {
    background-color: #2a1520;
    color: #f7768e;
    border: 1px solid #6b2d3e;
    border-radius: 7px;
    font-weight: 500;
}

QPushButton#uninstall_button:hover,
QPushButton#disable_button:hover {
    background-color: #3d1a28;
    border-color: #f7768e;
    color: #ff9ea8;
}

QPushButton#uninstall_button:pressed,
QPushButton#disable_button:pressed {
    background-color: #521c2c;
    border-color: #f7768e;
}

/* ── Color-picker buttons ───────────────────────────────── */
QPushButton#set_color_1_button,
QPushButton#set_color_2_button,
QPushButton#shadow_color_button {
    background-color: #24283b;
    color: #bb9af7;
    border: 1px dashed #414868;
    border-radius: 7px;
    padding: 6px 14px;
}

QPushButton#set_color_1_button:hover,
QPushButton#set_color_2_button:hover,
QPushButton#shadow_color_button:hover {
    background-color: #2a2e45;
    border-color: #bb9af7;
    border-style: solid;
    color: #c0caf5;
}

QPushButton#set_color_1_button:pressed,
QPushButton#set_color_2_button:pressed,
QPushButton#shadow_color_button:pressed {
    background-color: #3d3060;
    border-style: solid;
}

/* ── Combo Box ──────────────────────────────────────────── */
QComboBox {
    background-color: #24283b;
    color: #c0caf5;
    border: 1px solid #3b4261;
    border-radius: 7px;
    padding: 5px 32px 5px 10px;
    min-width: 100px;
    selection-background-color: transparent;
}

QComboBox:hover {
    border-color: #7aa2f7;
}

QComboBox:focus {
    border-color: #7aa2f7;
    background-color: #1f2235;
}

QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: right center;
    width: 28px;
    border: none;
    border-left: 1px solid #3b4261;
    background-color: transparent;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
}

QComboBox:hover::drop-down {
    border-left-color: #7aa2f7;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #7aa2f7;
    width: 0;
    height: 0;
}

QComboBox QAbstractItemView {
    background-color: #24283b;
    border: 1px solid #414868;
    border-radius: 7px;
    color: #c0caf5;
    selection-background-color: #2d3d7a;
    selection-color: #7aa2f7;
    padding: 4px;
    outline: none;
}

/* ── Sidebar (listWidget) ───────────────────────────────── */
QListWidget#listWidget {
    background-color: #16161e;
    border: none;
    border-right: 1px solid #24283b;
    border-radius: 0;
    padding: 10px 0;
    outline: none;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.4px;
}

QListWidget#listWidget::item {
    color: #565f89;
    padding: 13px 20px;
    border-radius: 0;
    border-left: 3px solid transparent;
}

QListWidget#listWidget::item:selected {
    background-color: #24283b;
    color: #7aa2f7;
    border-left: 3px solid #7aa2f7;
}

QListWidget#listWidget::item:hover:!selected {
    background-color: #1e2030;
    color: #a9b1d6;
    border-left: 3px solid #3b4261;
}

/* ── Inner (top) tab bar — sub-tabs within Hyprland ─────── */
QTabWidget#Hyprland_Menu_Settings > QTabBar {
    background: transparent;
}

QTabWidget#Hyprland_Menu_Settings > QTabBar::tab {
    background-color: #1a1b26;
    color: #565f89;
    border: 1px solid #3b4261;
    border-bottom: none;
    border-radius: 7px 7px 0 0;
    padding: 8px 20px;
    margin-right: 3px;
    font-size: 12px;
    letter-spacing: 0.3px;
}

QTabWidget#Hyprland_Menu_Settings > QTabBar::tab:selected {
    background-color: #24283b;
    color: #7aa2f7;
    border-color: #3b4261;
    border-bottom: 2px solid #7aa2f7;
}

QTabWidget#Hyprland_Menu_Settings > QTabBar::tab:hover:!selected {
    background-color: #1e2030;
    color: #a9b1d6;
    border-color: #414868;
}

QTabWidget::pane {
    background-color: #1a1b26;
    border: 1px solid #3b4261;
    border-radius: 0 0 8px 8px;
}

/* ── Secondary tab bar (keybinds, ecosystem) ─────────────── */
QTabWidget#keybinds_tabWidget > QTabBar::tab,
QTabWidget#ecosystem_tabWidget > QTabBar::tab {
    background-color: #1a1b26;
    color: #565f89;
    border: 1px solid #3b4261;
    border-bottom: none;
    border-radius: 6px 6px 0 0;
    padding: 6px 16px;
    margin-right: 3px;
    font-size: 12px;
}

QTabWidget#keybinds_tabWidget > QTabBar::tab:selected,
QTabWidget#ecosystem_tabWidget > QTabBar::tab:selected {
    background-color: #24283b;
    color: #7aa2f7;
    border-bottom: 2px solid #7aa2f7;
}

QTabWidget#keybinds_tabWidget > QTabBar::tab:hover:!selected,
QTabWidget#ecosystem_tabWidget > QTabBar::tab:hover:!selected {
    background-color: #1e2030;
    color: #a9b1d6;
}

/* ── Content List Widgets (autostart, env, wifi) ────────── */
QListWidget {
    background-color: #24283b;
    border: 1px solid #3b4261;
    border-radius: 8px;
    color: #c0caf5;
    padding: 4px;
    outline: none;
    font-size: 12px;
}

QListWidget::item {
    padding: 9px 12px;
    border-radius: 5px;
    color: #a9b1d6;
}

QListWidget::item:selected {
    background-color: #2d3d7a;
    color: #7aa2f7;
    border: none;
}

QListWidget::item:hover:!selected {
    background-color: #2a2e45;
    color: #c0caf5;
}

/* ── Scroll Area ────────────────────────────────────────── */
QScrollArea {
    background-color: #1a1b26;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: #1a1b26;
}

/* ── Scroll Bar ─────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    border-radius: 3px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #3b4261;
    border-radius: 3px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #7aa2f7;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    border-radius: 3px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #3b4261;
    border-radius: 3px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: #7aa2f7;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── Line Edit ──────────────────────────────────────────── */
QLineEdit {
    background-color: #24283b;
    color: #c0caf5;
    border: 1px solid #3b4261;
    border-radius: 7px;
    padding: 7px 10px;
    selection-background-color: #2d3d7a;
    selection-color: #7aa2f7;
}

QLineEdit:focus {
    border-color: #7aa2f7;
    background-color: #1f2235;
}

/* ── Check Box ──────────────────────────────────────────── */
QCheckBox {
    color: #a9b1d6;
    spacing: 9px;
    font-size: 12px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1.5px solid #414868;
    border-radius: 4px;
    background-color: #24283b;
}

QCheckBox::indicator:checked {
    background-color: #5d7bd4;
    border-color: #7aa2f7;
    image: none;
}

QCheckBox::indicator:hover {
    border-color: #7aa2f7;
    background-color: #2a2e45;
}

QCheckBox::indicator:checked:hover {
    background-color: #7aa2f7;
}

/* ── Spin Box ───────────────────────────────────────────── */
QSpinBox,
QDoubleSpinBox {
    background-color: #24283b;
    color: #c0caf5;
    border: 1px solid #3b4261;
    border-radius: 7px;
    padding: 5px 4px 5px 8px;
}

QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: #414868;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #7aa2f7;
    background-color: #1f2235;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    background-color: #2a2e45;
    width: 20px;
    height: 50%;
    border: none;
    border-left: 1px solid #3b4261;
    border-bottom: 1px solid #3b4261;
    border-top-right-radius: 6px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    background-color: #2a2e45;
    width: 20px;
    height: 50%;
    border: none;
    border-left: 1px solid #3b4261;
    border-bottom-right-radius: 6px;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #7aa2f7;
    width: 0;
    height: 0;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #7aa2f7;
    width: 0;
    height: 0;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #2d3d7a;
}

/* ── Tool Tip ───────────────────────────────────────────── */
QToolTip {
    background-color: #24283b;
    color: #c0caf5;
    border: 1px solid #414868;
    border-radius: 5px;
    padding: 5px 10px;
    font-size: 12px;
}

/* ── Menu Bar ───────────────────────────────────────────── */
QMenuBar {
    background-color: #16161e;
    color: #a9b1d6;
    border-bottom: 1px solid #24283b;
    padding: 2px 8px;
    font-size: 12px;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 12px;
    border-radius: 5px;
}

QMenuBar::item:selected {
    background-color: #24283b;
    color: #7aa2f7;
}

/* ── Dropdown Menu ──────────────────────────────────────── */
QMenu {
    background-color: #24283b;
    border: 1px solid #414868;
    border-radius: 8px;
    padding: 5px;
    color: #c0caf5;
}

QMenu::item {
    padding: 7px 22px 7px 14px;
    border-radius: 5px;
    font-size: 12px;
}

QMenu::item:selected {
    background-color: #2d3d7a;
    color: #7aa2f7;
}

QMenu::separator {
    height: 1px;
    background: #3b4261;
    margin: 4px 8px;
}

/* ── Group Box ──────────────────────────────────────────── */
QGroupBox {
    background-color: #24283b;
    border: 1px solid #3b4261;
    border-radius: 10px;
    margin-top: 18px;
    padding-top: 8px;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 0.8px;
    text-transform: uppercase;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 10px;
    left: 14px;
    top: 0px;
    color: #bb9af7;
    background-color: #1a1b26;
    border-radius: 4px;
}

QGroupBox QLabel {
    color: #a9b1d6;
    font-size: 12px;
    min-width: 110px;
    letter-spacing: 0;
}

QGroupBox QSpinBox,
QGroupBox QDoubleSpinBox {
    background-color: #1a1b26;
    min-width: 80px;
}

QGroupBox QComboBox {
    background-color: #1a1b26;
}

QGroupBox QPushButton {
    background-color: #24283b;
    border-color: #414868;
}

QGroupBox QPushButton:hover {
    background-color: #2a2e45;
    border-color: #7aa2f7;
    color: #a9b8ff;
}

QGroupBox QCheckBox {
    color: #c0caf5;
    font-size: 12px;
    letter-spacing: 0;
}

/* ── Placeholder labels (coming soon tabs) ───────────────── */
QLabel#windowrules_placeholder_label,
QLabel#hyprlock_placeholder_label,
QLabel#hyprsunset_placeholder_label,
QLabel#hyprpaper_placeholder_label {
    color: #414868;
    font-size: 13px;
    letter-spacing: 0.3px;
}

/* ── Status Bar ─────────────────────────────────────────── */
QStatusBar {
    background-color: #16161e;
    color: #565f89;
    border-top: 1px solid #24283b;
    font-size: 11px;
    padding: 0 10px;
}

QStatusBar::item {
    border: none;
}
