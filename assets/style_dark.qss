/* ============================================================
   Hyprset — Dark Theme
   ============================================================
   bg-base:    #0d1117   surface:    #161c2d
   bg-raised:  #1a2133   border:     #252f42
   accent:     #58a6ff   accent2:    #1f6feb
   text:       #e6edf3   muted:      #7d8590
   danger:     #f85149   success:    #3fb950
   ============================================================ */

/* ── Global ─────────────────────────────────────────────── */
QWidget {
    background-color: #0d1117;
    color: #e6edf3;
    font-family: "JetBrains Mono", "Fira Code", "Cascadia Code", monospace;
    font-size: 13px;
}

QMainWindow {
    background-color: #0d1117;
}

/* ── Labels ─────────────────────────────────────────────── */
QLabel {
    color: #8b949e;
    background: transparent;
    font-size: 12px;
    letter-spacing: 0.2px;
}

/* ── Push Buttons ───────────────────────────────────────── */
QPushButton {
    background-color: #1a2133;
    color: #c9d1d9;
    border: 1px solid #252f42;
    border-radius: 6px;
    padding: 7px 16px;
    font-size: 13px;
    letter-spacing: 0.2px;
}

QPushButton:hover {
    background-color: #1f2d45;
    color: #e6edf3;
    border-color: #58a6ff;
}

QPushButton:pressed {
    background-color: #1f6feb;
    color: #ffffff;
    border-color: #58a6ff;
}

QPushButton:disabled {
    background-color: #0d1117;
    color: #3d444d;
    border-color: #1c2433;
}

/* Primary / Apply button */
QPushButton#apply_button {
    background-color: #1f6feb;
    color: #ffffff;
    border: 1px solid #388bfd;
    font-weight: bold;
}

QPushButton#apply_button:hover {
    background-color: #388bfd;
    border-color: #79c0ff;
}

QPushButton#apply_button:pressed {
    background-color: #1158c7;
}

/* Danger / Delete button */
QPushButton#del_autostart_button,
QPushButton#del_env_button {
    background-color: #2a1215;
    color: #f85149;
    border-color: #6e2626;
}

QPushButton#del_autostart_button:hover,
QPushButton#del_env_button:hover {
    background-color: #3d1a1a;
    border-color: #f85149;
}

QPushButton#del_autostart_button:pressed,
QPushButton#del_env_button:pressed {
    background-color: #521c1c;
}

/* ── Combo Box ──────────────────────────────────────────── */
QComboBox {
    background-color: #161c2d;
    color: #e6edf3;
    border: 1px solid #252f42;
    border-radius: 6px;
    padding: 5px 10px;
    min-width: 100px;
}

QComboBox:hover {
    border-color: #58a6ff;
}

QComboBox:focus {
    border-color: #58a6ff;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
    subcontrol-origin: padding;
    subcontrol-position: right center;
}

QComboBox QAbstractItemView {
    background-color: #161c2d;
    border: 1px solid #252f42;
    border-radius: 6px;
    color: #e6edf3;
    selection-background-color: #1f3a6e;
    selection-color: #58a6ff;
    padding: 4px;
    outline: none;
}

/* ── Tab Widget ─────────────────────────────────────────── */
QTabWidget::pane {
    background-color: #0d1117;
    border: 1px solid #252f42;
    border-top: none;
    border-radius: 0 0 8px 8px;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background-color: #0d1117;
    color: #7d8590;
    border: 1px solid #252f42;
    border-bottom: none;
    border-radius: 6px 6px 0 0;
    padding: 7px 16px;
    margin-right: 2px;
    font-size: 12px;
    letter-spacing: 0.3px;
}

QTabBar::tab:selected {
    background-color: #161c2d;
    color: #58a6ff;
    border-color: #252f42;
    border-bottom: 2px solid #58a6ff;
}

QTabBar::tab:hover:!selected {
    background-color: #131921;
    color: #c9d1d9;
    border-color: #30363d;
}

/* ── List Widget ────────────────────────────────────────── */
QListWidget {
    background-color: #161c2d;
    border: 1px solid #252f42;
    border-radius: 6px;
    color: #e6edf3;
    padding: 4px;
    outline: none;
    font-size: 12px;
}

QListWidget::item {
    padding: 6px 10px;
    border-radius: 4px;
    color: #c9d1d9;
}

QListWidget::item:selected {
    background-color: #1f3a6e;
    color: #58a6ff;
    border: none;
}

QListWidget::item:hover:!selected {
    background-color: #1a2642;
    color: #e6edf3;
}

/* ── Scroll Area ────────────────────────────────────────── */
QScrollArea {
    background-color: #0d1117;
    border: 1px solid #252f42;
    border-radius: 6px;
}

QScrollArea > QWidget > QWidget {
    background-color: #0d1117;
}

/* ── Scroll Bar ─────────────────────────────────────────── */
QScrollBar:vertical {
    background: #0d1117;
    width: 6px;
    border-radius: 3px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #30363d;
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #58a6ff;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #0d1117;
    height: 6px;
    border-radius: 3px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #30363d;
    border-radius: 3px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #58a6ff;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── Line Edit ──────────────────────────────────────────── */
QLineEdit {
    background-color: #161c2d;
    color: #e6edf3;
    border: 1px solid #252f42;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #1f3a6e;
    selection-color: #58a6ff;
}

QLineEdit:focus {
    border-color: #58a6ff;
    background-color: #0d1520;
}

/* ── Check Box ──────────────────────────────────────────── */
QCheckBox {
    color: #c9d1d9;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #30363d;
    border-radius: 3px;
    background-color: #161c2d;
}

QCheckBox::indicator:checked {
    background-color: #1f6feb;
    border-color: #58a6ff;
}

QCheckBox::indicator:hover {
    border-color: #58a6ff;
}

/* ── Spin Box ───────────────────────────────────────────── */
QSpinBox,
QDoubleSpinBox {
    background-color: #161c2d;
    color: #e6edf3;
    border: 1px solid #252f42;
    border-radius: 6px;
    padding: 5px 8px;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #58a6ff;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button {
    background-color: #1a2133;
    border: none;
    width: 16px;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #1f2d45;
}

/* ── Slider ─────────────────────────────────────────────── */
QSlider::groove:horizontal {
    height: 4px;
    background: #1a2133;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #58a6ff;
    border: 2px solid #1f3a6e;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #79c0ff;
}

QSlider::sub-page:horizontal {
    background: #1f6feb;
    border-radius: 2px;
}

/* ── Tool Tip ───────────────────────────────────────────── */
QToolTip {
    background-color: #1a2133;
    color: #c9d1d9;
    border: 1px solid #30363d;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* ── Menu Bar ───────────────────────────────────────────── */
QMenuBar {
    background-color: #0d1117;
    color: #8b949e;
    border-bottom: 1px solid #21262d;
    padding: 2px 6px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #1a2133;
    color: #58a6ff;
}

/* ── Dropdown Menu ──────────────────────────────────────── */
QMenu {
    background-color: #161c2d;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 4px;
    color: #e6edf3;
}

QMenu::item {
    padding: 6px 20px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #1f3a6e;
    color: #58a6ff;
}

QMenu::separator {
    height: 1px;
    background: #30363d;
    margin: 4px 8px;
}

/* ── Group Box ──────────────────────────────────────────── */
QGroupBox {
    border: 1px solid #21262d;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 8px;
    color: #8b949e;
    font-size: 11px;
    letter-spacing: 0.5px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    left: 12px;
    color: #6e7681;
}

/* ── Status Bar ─────────────────────────────────────────── */
QStatusBar {
    background-color: #0d1117;
    color: #6e7681;
    border-top: 1px solid #21262d;
    font-size: 11px;
    padding: 0 8px;
}

QStatusBar::item {
    border: none;
}

/* ── Tool Bar ───────────────────────────────────────────── */
QToolBar {
    background-color: #161c2d;
    border-bottom: 1px solid #21262d;
    padding: 4px 8px;
    spacing: 4px;
}

QToolButton {
    background-color: transparent;
    color: #8b949e;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 5px 12px;
}

QToolButton:hover {
    background-color: #1a2133;
    color: #58a6ff;
    border-color: #252f42;
}

QToolButton:pressed,
QToolButton:checked {
    background-color: #1f3a6e;
    color: #58a6ff;
    border-color: #1f6feb;
}
