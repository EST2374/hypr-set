/* ============================================================
   Hyprset — Dark Theme  (v3)
   ============================================================
   bg-base:    #0d1117   surface:    #161c2d
   bg-raised:  #1a2133   border:     #252f42
   accent:     #58a6ff   accent2:    #1f6feb
   text:       #e6edf3   muted:      #7d8590
   danger:     #f85149   success:    #3fb950
   ============================================================ */

/* ── Global ─────────────────────────────────────────────── */
QWidget {
    background-color: #0d1117;
    color: #e6edf3;
    font-family: "JetBrains Mono", "Fira Code", "Cascadia Code", monospace;
    font-size: 13px;
}

QMainWindow {
    background-color: #0d1117;
}

/* ── Labels ─────────────────────────────────────────────── */
QLabel {
    color: #8b949e;
    background: transparent;
    font-size: 12px;
    letter-spacing: 0.2px;
}

/* ── Push Buttons ───────────────────────────────────────── */
QPushButton {
    background-color: #1a2133;
    color: #c9d1d9;
    border: 1px solid #252f42;
    border-radius: 7px;
    padding: 7px 18px;
    font-size: 13px;
    letter-spacing: 0.2px;
    outline: none;
}

QPushButton:hover {
    background-color: #1f2d45;
    color: #e6edf3;
    border-color: #58a6ff;
}

QPushButton:pressed {
    background-color: #1f6feb;
    color: #ffffff;
    border-color: #58a6ff;
}

QPushButton:focus {
    border-color: #58a6ff;
    outline: none;
}

QPushButton:disabled {
    background-color: #0d1117;
    color: #3d444d;
    border-color: #1c2433;
}

/* ── Primary / Apply button ─────────────────────────────── */
QPushButton#apply_button {
    background-color: #1f6feb;
    color: #ffffff;
    border: 1px solid #388bfd;
    border-radius: 7px;
    font-weight: bold;
    letter-spacing: 0.4px;
}

QPushButton#apply_button:hover {
    background-color: #388bfd;
    border-color: #79c0ff;
}

QPushButton#apply_button:pressed {
    background-color: #1158c7;
    border-color: #58a6ff;
}

/* ── Danger / Delete buttons ────────────────────────────── */
QPushButton#del_autostart_button,
QPushButton#del_env_button {
    background-color: #2a1215;
    color: #f85149;
    border-color: #6e2626;
    border-radius: 7px;
}

QPushButton#del_autostart_button:hover,
QPushButton#del_env_button:hover {
    background-color: #3d1a1a;
    border-color: #f85149;
    color: #ff6b63;
}

QPushButton#del_autostart_button:pressed,
QPushButton#del_env_button:pressed {
    background-color: #521c1c;
}

/* ── Color-picker buttons ───────────────────────────────── */
QPushButton#set_color_1_button,
QPushButton#set_color_2_button,
QPushButton#shadow_color_button {
    background-color: #161c2d;
    color: #79c0ff;
    border: 1px dashed #30363d;
    border-radius: 7px;
    padding: 6px 14px;
}

QPushButton#set_color_1_button:hover,
QPushButton#set_color_2_button:hover,
QPushButton#shadow_color_button:hover {
    background-color: #1a2133;
    border-color: #58a6ff;
    border-style: solid;
    color: #c9d1d9;
}

QPushButton#set_color_1_button:pressed,
QPushButton#set_color_2_button:pressed,
QPushButton#shadow_color_button:pressed {
    background-color: #1f3a6e;
    border-style: solid;
}

/* ── Combo Box ──────────────────────────────────────────── */
QComboBox {
    background-color: #161c2d;
    color: #e6edf3;
    border: 1px solid #252f42;
    border-radius: 7px;
    padding: 5px 10px;
    min-width: 100px;
}

QComboBox:hover {
    border-color: #58a6ff;
}

QComboBox:focus {
    border-color: #58a6ff;
    background-color: #0d1520;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
    subcontrol-origin: padding;
    subcontrol-position: right center;
}

QComboBox::hover {
    border-color: #58a6ff;
}

QComboBox QAbstractItemView {
    background-color: #161c2d;
    border: 1px solid #252f42;
    border-radius: 7px;
    color: #e6edf3;
    selection-background-color: #1f3a6e;
    selection-color: #58a6ff;
    padding: 4px;
    outline: none;
}

/* ── Sidebar (listWidget) ───────────────────────────────── */
QListWidget#listWidget {
    background-color: #0a0e17;
    border: none;
    border-right: 1px solid #1c2433;
    border-radius: 0;
    padding: 8px 0;
    outline: none;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.4px;
}

QListWidget#listWidget::item {
    color: #7d8590;
    padding: 12px 20px 12px 20px;
    border-radius: 0;
    border-left: 3px solid transparent;
}

QListWidget#listWidget::item:selected {
    background-color: #161c2d;
    color: #58a6ff;
    border-left: 3px solid #58a6ff;
}

QListWidget#listWidget::item:hover:!selected {
    background-color: #111825;
    color: #c9d1d9;
    border-left: 3px solid #30363d;
}

/* ── Inner (top) tab bar — sub-tabs within Hyprland ─────── */
QTabWidget#Hyprland_Menu_Settings > QTabBar {
    background: transparent;
}

QTabWidget#Hyprland_Menu_Settings > QTabBar::tab {
    background-color: #0d1117;
    color: #7d8590;
    border: 1px solid #252f42;
    border-bottom: none;
    border-radius: 7px 7px 0 0;
    padding: 7px 18px;
    margin-right: 3px;
    font-size: 12px;
    letter-spacing: 0.3px;
}

QTabWidget#Hyprland_Menu_Settings > QTabBar::tab:selected {
    background-color: #161c2d;
    color: #58a6ff;
    border-color: #252f42;
    border-bottom: 2px solid #58a6ff;
}

QTabWidget#Hyprland_Menu_Settings > QTabBar::tab:hover:!selected {
    background-color: #131921;
    color: #c9d1d9;
    border-color: #30363d;
}

QTabWidget::pane {
    background-color: #0d1117;
    border: 1px solid #252f42;
    border-radius: 0 0 8px 8px;
}

/* ── Content List Widgets (autostart, env, wifi) ────────── */
QListWidget {
    background-color: #161c2d;
    border: 1px solid #252f42;
    border-radius: 8px;
    color: #e6edf3;
    padding: 4px;
    outline: none;
    font-size: 12px;
}

QListWidget::item {
    padding: 8px 12px;
    border-radius: 5px;
    color: #c9d1d9;
}

QListWidget::item:selected {
    background-color: #1f3a6e;
    color: #58a6ff;
    border: none;
}

QListWidget::item:hover:!selected {
    background-color: #1a2642;
    color: #e6edf3;
}

/* ── Scroll Area ────────────────────────────────────────── */
QScrollArea {
    background-color: #0d1117;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: #0d1117;
}

/* ── Scroll Bar ─────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    border-radius: 3px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #252f42;
    border-radius: 3px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #58a6ff;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    border-radius: 3px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #252f42;
    border-radius: 3px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: #58a6ff;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── Line Edit ──────────────────────────────────────────── */
QLineEdit {
    background-color: #161c2d;
    color: #e6edf3;
    border: 1px solid #252f42;
    border-radius: 7px;
    padding: 7px 10px;
    selection-background-color: #1f3a6e;
    selection-color: #58a6ff;
}

QLineEdit:focus {
    border-color: #58a6ff;
    background-color: #0d1520;
}

/* ── Check Box ──────────────────────────────────────────── */
QCheckBox {
    color: #c9d1d9;
    spacing: 9px;
    font-size: 12px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1.5px solid #30363d;
    border-radius: 4px;
    background-color: #161c2d;
}

QCheckBox::indicator:checked {
    background-color: #1f6feb;
    border-color: #58a6ff;
    image: none;
}

QCheckBox::indicator:hover {
    border-color: #58a6ff;
    background-color: #1a2133;
}

QCheckBox::indicator:checked:hover {
    background-color: #388bfd;
}

/* ── Spin Box ───────────────────────────────────────────── */
QSpinBox,
QDoubleSpinBox {
    background-color: #161c2d;
    color: #e6edf3;
    border: 1px solid #252f42;
    border-radius: 7px;
    padding: 5px 8px;
}

QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: #30363d;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #58a6ff;
    background-color: #0d1520;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #1a2133;
    width: 16px;
    border: none;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    border-left: 4px solid none;
    border-right: 4px solid none;
    border-bottom: 5px solid #58a6ff;
    width: 0;
    height: 0;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    border-left: 4px solid none;
    border-right: 4px solid none;
    border-top: 5px solid #58a6ff;
    width: 0;
    height: 0;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #1f2d45;
}

/* ── Tool Tip ───────────────────────────────────────────── */
QToolTip {
    background-color: #1a2133;
    color: #c9d1d9;
    border: 1px solid #30363d;
    border-radius: 5px;
    padding: 5px 10px;
    font-size: 12px;
}

/* ── Menu Bar ───────────────────────────────────────────── */
QMenuBar {
    background-color: #0a0e17;
    color: #8b949e;
    border-bottom: 1px solid #1c2433;
    padding: 2px 8px;
    font-size: 12px;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 12px;
    border-radius: 5px;
}

QMenuBar::item:selected {
    background-color: #1a2133;
    color: #58a6ff;
}

/* ── Dropdown Menu ──────────────────────────────────────── */
QMenu {
    background-color: #161c2d;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 5px;
    color: #e6edf3;
}

QMenu::item {
    padding: 7px 22px 7px 14px;
    border-radius: 5px;
    font-size: 12px;
}

QMenu::item:selected {
    background-color: #1f3a6e;
    color: #58a6ff;
}

QMenu::separator {
    height: 1px;
    background: #252f42;
    margin: 4px 8px;
}

/* ── Group Box ──────────────────────────────────────────── */
QGroupBox {
    background-color: #161c2d;
    border: 1px solid #252f42;
    border-radius: 10px;
    margin-top: 16px;
    padding-top: 6px;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 0.8px;
    text-transform: uppercase;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 10px;
    left: 14px;
    top: 0px;
    color: #58a6ff;
    background-color: #0d1117;
    border-radius: 4px;
}

QGroupBox QLabel {
    color: #c9d1d9;
    font-size: 12px;
    min-width: 110px;
    letter-spacing: 0;
}

QGroupBox QSpinBox,
QGroupBox QDoubleSpinBox {
    background-color: #0d1117;
    min-width: 80px;
}

QGroupBox QComboBox {
    background-color: #0d1117;
}

QGroupBox QPushButton {
    background-color: #1a2133;
    border-color: #30363d;
}

QGroupBox QPushButton:hover {
    background-color: #1f2d45;
    border-color: #58a6ff;
    color: #79c0ff;
}

QGroupBox QCheckBox {
    color: #e6edf3;
    font-size: 12px;
    letter-spacing: 0;
}

/* ── Status Bar ─────────────────────────────────────────── */
QStatusBar {
    background-color: #0a0e17;
    color: #6e7681;
    border-top: 1px solid #1c2433;
    font-size: 11px;
    padding: 0 10px;
}

QStatusBar::item {
    border: none;
}
