/* =========================================================
   Minimalist Dark Theme — Nord Grey
   Für: Hyprland Settings Widget
   ========================================================= */

/* ---------- Base ---------- */
QWidget {
    background-color: #2e3440;
    color: #d8dee9;
    font-family: "Inter", "Segoe UI", "SF Pro Text", sans-serif;
    font-size: 13px;
}

QMainWindow,
QWidget#centralwidget {
    background-color: #2e3440;
}

/* ---------- Sidebar (QListWidget) ---------- */
QListWidget {
    background-color: #292e39;
    border: none;
    border-right: 1px solid #3b4252;
    padding: 12px 8px;
    outline: 0;
}

QListWidget::item {
    background-color: transparent;
    color: #8a93a6;
    padding: 9px 14px;
    margin: 2px 0;
    border-radius: 6px;
}

QListWidget::item:hover {
    background-color: #3b4252;
    color: #eceff4;
}

QListWidget::item:selected {
    background-color: #434c5e;
    color: #eceff4;
}

/* ---------- Current Connection (single-row list) ---------- */
QListWidget#current_connection_list {
    background-color: #3b4252;
    border: 1px solid #434c5e;
    border-radius: 6px;
    padding: 2px 6px;
    font-size: 12px;
}

QListWidget#current_connection_list::item {
    color: #a3be8c;
    padding: 3px 8px;
    margin: 0 2px;
    border-radius: 4px;
}

QListWidget#current_connection_list::item:hover {
    background-color: #434c5e;
    color: #eceff4;
}

QListWidget#current_connection_list::item:selected {
    background-color: #4c566a;
    color: #eceff4;
}

/* ---------- StackedWidget / Content Area ---------- */
QStackedWidget {
    background-color: #2e3440;
    border: none;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* ---------- GroupBox ---------- */
QGroupBox {
    background-color: #353b48;
    border: 1px solid #3b4252;
    border-radius: 8px;
    margin-top: 18px;
    padding: 18px 14px 14px 14px;
    font-weight: 500;
    color: #eceff4;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    background-color: #2e3440;
    color: #81a1c1;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.4px;
}

/* ---------- Labels ---------- */
QLabel {
    background-color: transparent;
    color: #d8dee9;
}

/* ---------- Buttons ---------- */
QPushButton {
    background-color: #3b4252;
    color: #eceff4;
    border: 1px solid #434c5e;
    border-radius: 6px;
    padding: 6px 14px;
    min-height: 22px;
}

QPushButton:hover {
    background-color: #434c5e;
    border-color: #4c566a;
}

QPushButton:pressed {
    background-color: #4c566a;
    border-color: #5e6779;
}

QPushButton:disabled {
    background-color: #353b48;
    color: #5e6779;
    border-color: #3b4252;
}

/* ---------- LineEdit / SpinBox / ComboBox ---------- */
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    background-color: #3b4252;
    color: #eceff4;
    border: 1px solid #434c5e;
    border-radius: 6px;
    padding: 5px 10px;
    min-height: 22px;
    selection-background-color: #4c566a;
    selection-color: #eceff4;
}

QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QComboBox:hover {
    border-color: #4c566a;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus {
    border-color: #88c0d0;
}

/* SpinBox arrows — minimal */
QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    border: none;
    background: transparent;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    border: none;
    background: transparent;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #8a93a6;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #8a93a6;
}

QSpinBox::up-arrow:hover,
QDoubleSpinBox::up-arrow:hover {
    border-bottom-color: #eceff4;
}

QSpinBox::down-arrow:hover,
QDoubleSpinBox::down-arrow:hover {
    border-top-color: #eceff4;
}

/* ComboBox dropdown */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 22px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #8a93a6;
    margin-right: 8px;
}

QComboBox::down-arrow:hover {
    border-top-color: #eceff4;
}

QComboBox QAbstractItemView {
    background-color: #3b4252;
    color: #eceff4;
    border: 1px solid #434c5e;
    border-radius: 6px;
    padding: 4px;
    outline: 0;
    selection-background-color: #434c5e;
    selection-color: #eceff4;
}

/* ---------- CheckBox ---------- */
QCheckBox {
    background-color: transparent;
    color: #d8dee9;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #4c566a;
    border-radius: 4px;
    background-color: #3b4252;
}

QCheckBox::indicator:hover {
    border-color: #88c0d0;
}

QCheckBox::indicator:checked {
    background-color: #88c0d0;
    border-color: #88c0d0;
    image: none;
}

QCheckBox::indicator:checked:hover {
    background-color: #8fbcbb;
    border-color: #8fbcbb;
}

/* ---------- TabWidget ---------- */
QTabWidget::pane {
    border: 1px solid #3b4252;
    border-radius: 6px;
    background-color: #353b48;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #8a93a6;
    padding: 7px 16px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 4px;
}

QTabBar::tab:hover {
    color: #eceff4;
}

QTabBar::tab:selected {
    color: #eceff4;
    border-bottom: 2px solid #88c0d0;
    font-weight: 500;
}

/* ---------- ScrollBar — slim, minimal ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background: #434c5e;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #4c566a;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: transparent;
    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #434c5e;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #4c566a;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: transparent;
    border: none;
}

/* ---------- Menu / MenuBar ---------- */
QMenuBar {
    background-color: #2e3440;
    color: #d8dee9;
    border-bottom: 1px solid #3b4252;
    padding: 2px 6px;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #3b4252;
}

QMenu {
    background-color: #3b4252;
    color: #eceff4;
    border: 1px solid #434c5e;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 18px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #434c5e;
}

QMenu::separator {
    height: 1px;
    background: #3b4252;
    margin: 4px 6px;
}

/* ---------- StatusBar ---------- */
QStatusBar {
    background-color: #292e39;
    color: #8a93a6;
    border-top: 1px solid #3b4252;
}

/* ---------- ToolTip ---------- */
QToolTip {
    background-color: #eceff4;
    color: #2e3440;
    border: none;
    border-radius: 4px;
    padding: 5px 8px;
}

/* ---------- Frame ---------- */
QFrame {
    background-color: transparent;
}
