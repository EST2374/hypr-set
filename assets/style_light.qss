/* ============================================================
   Hyprset — Light Theme
   ============================================================
   bg-base:    #f6f8fa   surface:    #ffffff
   bg-raised:  #eaeef2   border:     #d0d7de
   accent:     #0969da   accent2:    #0550ae
   text:       #1f2328   muted:      #57606a
   danger:     #cf222e   success:    #1a7f37
   ============================================================ */

/* ── Global ─────────────────────────────────────────────── */
QWidget {
    background-color: #f6f8fa;
    color: #1f2328;
    font-family: "JetBrains Mono", "Fira Code", "Cascadia Code", monospace;
    font-size: 13px;
}

QMainWindow {
    background-color: #f6f8fa;
}

/* ── Labels ─────────────────────────────────────────────── */
QLabel {
    color: #57606a;
    background: transparent;
    font-size: 12px;
    letter-spacing: 0.2px;
}

/* ── Push Buttons ───────────────────────────────────────── */
QPushButton {
    background-color: #eaeef2;
    color: #1f2328;
    border: 1px solid #d0d7de;
    border-radius: 6px;
    padding: 7px 16px;
    font-size: 13px;
    letter-spacing: 0.2px;
}

QPushButton:hover {
    background-color: #dde1e6;
    color: #0969da;
    border-color: #0969da;
}

QPushButton:pressed {
    background-color: #0969da;
    color: #ffffff;
    border-color: #0550ae;
}

QPushButton:disabled {
    background-color: #f6f8fa;
    color: #8c959f;
    border-color: #d8dee4;
}

/* Primary / Apply button */
QPushButton#apply_button {
    background-color: #0969da;
    color: #ffffff;
    border: 1px solid #0550ae;
    font-weight: bold;
}

QPushButton#apply_button:hover {
    background-color: #0860ca;
    border-color: #0550ae;
}

QPushButton#apply_button:pressed {
    background-color: #0550ae;
}

/* Danger / Delete button */
QPushButton#del_autostart_button,
QPushButton#del_env_button {
    background-color: #fff0ee;
    color: #cf222e;
    border-color: #ffc1c0;
}

QPushButton#del_autostart_button:hover,
QPushButton#del_env_button:hover {
    background-color: #ffe4e2;
    border-color: #cf222e;
}

QPushButton#del_autostart_button:pressed,
QPushButton#del_env_button:pressed {
    background-color: #ffc1c0;
}

/* ── Combo Box ──────────────────────────────────────────── */
QComboBox {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #d0d7de;
    border-radius: 6px;
    padding: 5px 10px;
    min-width: 100px;
}

QComboBox:hover {
    border-color: #0969da;
}

QComboBox:focus {
    border-color: #0969da;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
    subcontrol-origin: padding;
    subcontrol-position: right center;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 6px;
    color: #1f2328;
    selection-background-color: #ddf4ff;
    selection-color: #0969da;
    padding: 4px;
    outline: none;
}

/* ── Tab Widget ─────────────────────────────────────────── */
QTabWidget::pane {
    background-color: #f6f8fa;
    border: 1px solid #d0d7de;
    border-top: none;
    border-radius: 0 0 8px 8px;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background-color: #f6f8fa;
    color: #57606a;
    border: 1px solid #d0d7de;
    border-bottom: none;
    border-radius: 6px 6px 0 0;
    padding: 7px 16px;
    margin-right: 2px;
    font-size: 12px;
    letter-spacing: 0.3px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #0969da;
    border-color: #d0d7de;
    border-bottom: 2px solid #0969da;
}

QTabBar::tab:hover:!selected {
    background-color: #eaeef2;
    color: #1f2328;
    border-color: #bbc0c6;
}

/* ── List Widget ────────────────────────────────────────── */
QListWidget {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 6px;
    color: #1f2328;
    padding: 4px;
    outline: none;
    font-size: 12px;
}

QListWidget::item {
    padding: 6px 10px;
    border-radius: 4px;
    color: #1f2328;
}

QListWidget::item:selected {
    background-color: #ddf4ff;
    color: #0969da;
    border: none;
}

QListWidget::item:hover:!selected {
    background-color: #eaeef2;
    color: #1f2328;
}

/* ── Scroll Area ────────────────────────────────────────── */
QScrollArea {
    background-color: #f6f8fa;
    border: 1px solid #d0d7de;
    border-radius: 6px;
}

QScrollArea > QWidget > QWidget {
    background-color: #f6f8fa;
}

/* ── Scroll Bar ─────────────────────────────────────────── */
QScrollBar:vertical {
    background: #f6f8fa;
    width: 6px;
    border-radius: 3px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #bbc0c6;
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #0969da;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #f6f8fa;
    height: 6px;
    border-radius: 3px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #bbc0c6;
    border-radius: 3px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #0969da;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── Line Edit ──────────────────────────────────────────── */
QLineEdit {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #d0d7de;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #ddf4ff;
    selection-color: #0969da;
}

QLineEdit:focus {
    border-color: #0969da;
    background-color: #f8fbff;
}

/* ── Check Box ──────────────────────────────────────────── */
QCheckBox {
    color: #1f2328;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #bbc0c6;
    border-radius: 3px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #0969da;
    border-color: #0550ae;
}

QCheckBox::indicator:hover {
    border-color: #0969da;
}

/* ── Spin Box ───────────────────────────────────────────── */
QSpinBox,
QDoubleSpinBox {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #d0d7de;
    border-radius: 6px;
    padding: 5px 8px;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #0969da;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button {
    background-color: #eaeef2;
    border: none;
    width: 16px;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #dde1e6;
}

/* ── Slider ─────────────────────────────────────────────── */
QSlider::groove:horizontal {
    height: 4px;
    background: #d0d7de;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #0969da;
    border: 2px solid #ddf4ff;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #0550ae;
}

QSlider::sub-page:horizontal {
    background: #0969da;
    border-radius: 2px;
}

/* ── Tool Tip ───────────────────────────────────────────── */
QToolTip {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #d0d7de;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* ── Menu Bar ───────────────────────────────────────────── */
QMenuBar {
    background-color: #f6f8fa;
    color: #57606a;
    border-bottom: 1px solid #d0d7de;
    padding: 2px 6px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #eaeef2;
    color: #0969da;
}

/* ── Dropdown Menu ──────────────────────────────────────── */
QMenu {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 6px;
    padding: 4px;
    color: #1f2328;
}

QMenu::item {
    padding: 6px 20px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #ddf4ff;
    color: #0969da;
}

QMenu::separator {
    height: 1px;
    background: #d0d7de;
    margin: 4px 8px;
}

/* ── Group Box ──────────────────────────────────────────── */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 10px;
    margin-top: 14px;
    padding: 14px 10px 10px 10px;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 0.8px;
    text-transform: uppercase;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 8px;
    left: 14px;
    color: #0969da;
    background-color: #f6f8fa;
    border-radius: 4px;
}

/* Look-and-Feel tab: labels inside GroupBoxes are more prominent */
QGroupBox QLabel {
    color: #1f2328;
    font-size: 12px;
    min-width: 120px;
}

/* SpinBoxes and inputs inside GroupBoxes get a slightly raised bg */
QGroupBox QSpinBox,
QGroupBox QDoubleSpinBox {
    background-color: #f6f8fa;
    min-width: 80px;
}

QGroupBox QComboBox {
    background-color: #f6f8fa;
}

/* Color picker buttons in GroupBox */
QGroupBox QPushButton {
    background-color: #eaeef2;
    border-color: #bbc0c6;
}

QGroupBox QPushButton:hover {
    background-color: #dde1e6;
    border-color: #0969da;
    color: #0550ae;
}

/* Checkboxes inside GroupBox */
QGroupBox QCheckBox {
    color: #1f2328;
    font-size: 12px;
}

/* ── Status Bar ─────────────────────────────────────────── */
QStatusBar {
    background-color: #f6f8fa;
    color: #57606a;
    border-top: 1px solid #d0d7de;
    font-size: 11px;
    padding: 0 8px;
}

QStatusBar::item {
    border: none;
}

/* ── Tool Bar ───────────────────────────────────────────── */
QToolBar {
    background-color: #ffffff;
    border-bottom: 1px solid #d0d7de;
    padding: 4px 8px;
    spacing: 4px;
}

QToolButton {
    background-color: transparent;
    color: #57606a;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 5px 12px;
}

QToolButton:hover {
    background-color: #eaeef2;
    color: #0969da;
    border-color: #d0d7de;
}

QToolButton:pressed,
QToolButton:checked {
    background-color: #ddf4ff;
    color: #0969da;
    border-color: #0969da;
}
