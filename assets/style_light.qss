/* ============================================================
   Hyprset — Light Theme  (v5 · Catppuccin Latte)
   ============================================================
   bg-base:    #eff1f5   surface:    #ffffff
   bg-raised:  #e6e9ef   border:     #ccd0da
   accent:     #1e66f5   accent2:    #1558d6
   mauve:      #8839ef   teal:       #179299
   text:       #4c4f69   muted:      #8c8fa1
   danger:     #d20f39   success:    #40a02b
   ============================================================ */

/* ── Global ─────────────────────────────────────────────── */
QWidget {
    background-color: #eff1f5;
    color: #4c4f69;
    font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", "FiraCode Nerd Font", "Fira Code", "Cascadia Code", monospace;
    font-size: 13px;
}

QMainWindow {
    background-color: #eff1f5;
}

/* ── Labels ─────────────────────────────────────────────── */
QLabel {
    color: #6c6f85;
    background: transparent;
    font-size: 12px;
    letter-spacing: 0.2px;
}

/* ── Push Buttons ───────────────────────────────────────── */
QPushButton {
    background-color: #e6e9ef;
    color: #4c4f69;
    border: 1px solid #ccd0da;
    border-radius: 7px;
    padding: 7px 18px;
    font-size: 13px;
    letter-spacing: 0.2px;
    outline: none;
    min-height: 30px;
}

QPushButton:hover {
    background-color: #dce0e8;
    color: #1e66f5;
    border-color: #1e66f5;
}

QPushButton:pressed {
    background-color: #1e66f5;
    color: #ffffff;
    border-color: #1558d6;
}

QPushButton:focus {
    border-color: #1e66f5;
    outline: none;
}

QPushButton:disabled {
    background-color: #eff1f5;
    color: #acafc4;
    border-color: #dce0e8;
}

/* ── Primary / Apply button ─────────────────────────────── */
QPushButton#apply_button {
    background-color: #1e66f5;
    color: #ffffff;
    border: 1px solid #1558d6;
    border-radius: 7px;
    font-weight: bold;
    letter-spacing: 0.4px;
    min-height: 36px;
}

QPushButton#apply_button:hover {
    background-color: #1558d6;
    border-color: #1249b8;
}

QPushButton#apply_button:pressed {
    background-color: #1249b8;
    border-color: #0e3a9a;
}

/* ── Danger / Delete buttons ────────────────────────────── */
QPushButton#del_autostart_button,
QPushButton#del_env_button,
QPushButton#delete_keybind_button,
QPushButton#delete_movement_button,
QPushButton#delete_workspace_button,
QPushButton#delete_multimedia_button,
QPushButton#wifi_disconnect_button {
    background-color: #fce8ec;
    color: #d20f39;
    border-color: #f5bdc8;
    border-radius: 7px;
}

QPushButton#del_autostart_button:hover,
QPushButton#del_env_button:hover,
QPushButton#delete_keybind_button:hover,
QPushButton#delete_movement_button:hover,
QPushButton#delete_workspace_button:hover,
QPushButton#delete_multimedia_button:hover,
QPushButton#wifi_disconnect_button:hover {
    background-color: #f8d0d8;
    border-color: #d20f39;
    color: #a80c2d;
}

QPushButton#del_autostart_button:pressed,
QPushButton#del_env_button:pressed,
QPushButton#delete_keybind_button:pressed,
QPushButton#delete_movement_button:pressed,
QPushButton#delete_workspace_button:pressed,
QPushButton#delete_multimedia_button:pressed,
QPushButton#wifi_disconnect_button:pressed {
    background-color: #f5bdc8;
}

/* ── Secondary action buttons (Set Default / Update) ────── */
QPushButton#set_default_look_button,
QPushButton#input_set_default_button,
QPushButton#set_default_monitor_button,
QPushButton#set_default_general_keybind_button,
QPushButton#set_default_movement_button,
QPushButton#set_default_workspace_button,
QPushButton#set_default_multimedia_button,
QPushButton#update_pushButton {
    min-width: 120px;
    min-height: 34px;
    background-color: #e6e9ef;
    color: #4c4f69;
    border: 1px solid #ccd0da;
    border-radius: 7px;
    font-weight: 500;
    letter-spacing: 0.3px;
    padding: 7px 18px;
}

QPushButton#set_default_look_button:hover,
QPushButton#input_set_default_button:hover,
QPushButton#set_default_monitor_button:hover,
QPushButton#set_default_general_keybind_button:hover,
QPushButton#set_default_movement_button:hover,
QPushButton#set_default_workspace_button:hover,
QPushButton#set_default_multimedia_button:hover,
QPushButton#update_pushButton:hover {
    background-color: #dce0e8;
    border-color: #1e66f5;
    color: #1558d6;
}

/* ── Add buttons (inline actions) ───────────────────────── */
QPushButton#general_add_button,
QPushButton#movement_add_button,
QPushButton#workspace_add_button,
QPushButton#multimedia_add_button,
QPushButton#add_program_button,
QPushButton#add_script_button,
QPushButton#add_env_button,
QPushButton#wifi_refresh_button {
    background-color: #deeaff;
    color: #1e66f5;
    border: 1px solid #b8d0ff;
    border-radius: 7px;
    font-weight: 500;
}

QPushButton#general_add_button:hover,
QPushButton#movement_add_button:hover,
QPushButton#workspace_add_button:hover,
QPushButton#multimedia_add_button:hover,
QPushButton#add_program_button:hover,
QPushButton#add_script_button:hover,
QPushButton#add_env_button:hover,
QPushButton#wifi_refresh_button:hover {
    background-color: #b8d0ff;
    border-color: #1e66f5;
    color: #1558d6;
}

QPushButton#general_add_button:pressed,
QPushButton#movement_add_button:pressed,
QPushButton#workspace_add_button:pressed,
QPushButton#multimedia_add_button:pressed,
QPushButton#add_program_button:pressed,
QPushButton#add_script_button:pressed,
QPushButton#add_env_button:pressed,
QPushButton#wifi_refresh_button:pressed {
    background-color: #90b8ff;
    border-color: #1558d6;
}

/* ── Window Rule buttons ─────────────────────────────────── */
QPushButton#add_window_rule_button {
    background-color: #deeaff;
    color: #1e66f5;
    border: 1px solid #b8d0ff;
    border-radius: 7px;
    font-weight: 500;
}

QPushButton#add_window_rule_button:hover {
    background-color: #b8d0ff;
    border-color: #1e66f5;
    color: #1558d6;
}

QPushButton#add_window_rule_button:pressed {
    background-color: #90b8ff;
    border-color: #1558d6;
}

QPushButton#edit_window_rule_button {
    background-color: #e6e9ef;
    color: #4c4f69;
    border: 1px solid #ccd0da;
    border-radius: 7px;
    font-weight: 500;
}

QPushButton#edit_window_rule_button:hover {
    background-color: #dce0e8;
    border-color: #1e66f5;
    color: #1558d6;
}

QPushButton#edit_window_rule_button:pressed {
    background-color: #deeaff;
    border-color: #1558d6;
}

QPushButton#delete_window_rule_button {
    background-color: #fce8ec;
    color: #d20f39;
    border-color: #f5bdc8;
    border-radius: 7px;
}

QPushButton#delete_window_rule_button:hover {
    background-color: #f8d0d8;
    border-color: #d20f39;
    color: #a80c2d;
}

QPushButton#delete_window_rule_button:pressed {
    background-color: #f5bdc8;
}

/* ── File chooser buttons ────────────────────────────────── */
QPushButton#choose_config_file_button,
QPushButton#choose_hyprlock_button,
QPushButton#choose_hypersunset_button,
QPushButton#choose_hyperpaper_file_button,
QPushButton#choose_hypridle_button {
    background-color: #e6e9ef;
    color: #4c4f69;
    border: 1px solid #c5c8d5;
    border-radius: 7px;
    font-weight: 500;
    padding: 6px 16px;
    min-height: 30px;
}

QPushButton#choose_config_file_button:hover,
QPushButton#choose_hyprlock_button:hover,
QPushButton#choose_hypersunset_button:hover,
QPushButton#choose_hyperpaper_file_button:hover,
QPushButton#choose_hypridle_button:hover {
    background-color: #dce0e8;
    border-color: #1e66f5;
    color: #1558d6;
}

QPushButton#choose_config_file_button:pressed,
QPushButton#choose_hyprlock_button:pressed,
QPushButton#choose_hypersunset_button:pressed,
QPushButton#choose_hyperpaper_file_button:pressed,
QPushButton#choose_hypridle_button:pressed {
    background-color: #deeaff;
    border-color: #1558d6;
}

/* ── Success / Install / Enable buttons ─────────────────── */
QPushButton#choose_folder_button,
QPushButton#install_button,
QPushButton#enable_button {
    background-color: #d8f5e1;
    color: #40a02b;
    border: 1px solid #a3e0b5;
    border-radius: 7px;
    font-weight: 500;
}

QPushButton#choose_folder_button:hover,
QPushButton#install_button:hover,
QPushButton#enable_button:hover {
    background-color: #b4edca;
    border-color: #40a02b;
    color: #317a22;
}

QPushButton#choose_folder_button:pressed,
QPushButton#install_button:pressed,
QPushButton#enable_button:pressed {
    background-color: #8fe0b0;
    border-color: #317a22;
}

/* ── Neutral-danger / Uninstall / Disable buttons ───────── */
QPushButton#uninstall_button,
QPushButton#disable_button {
    background-color: #fce8ec;
    color: #d20f39;
    border: 1px solid #f5bdc8;
    border-radius: 7px;
    font-weight: 500;
}

QPushButton#uninstall_button:hover,
QPushButton#disable_button:hover {
    background-color: #f8d0d8;
    border-color: #d20f39;
    color: #a80c2d;
}

QPushButton#uninstall_button:pressed,
QPushButton#disable_button:pressed {
    background-color: #f5bdc8;
    border-color: #a80c2d;
}

/* ── Color-picker buttons ───────────────────────────────── */
QPushButton#set_color_1_button,
QPushButton#set_color_2_button,
QPushButton#shadow_color_button {
    background-color: #ffffff;
    color: #8839ef;
    border: 1px dashed #c5c8d5;
    border-radius: 7px;
    padding: 6px 14px;
}

QPushButton#set_color_1_button:hover,
QPushButton#set_color_2_button:hover,
QPushButton#shadow_color_button:hover {
    background-color: #f0ecfb;
    border-color: #8839ef;
    border-style: solid;
    color: #4c4f69;
}

QPushButton#set_color_1_button:pressed,
QPushButton#set_color_2_button:pressed,
QPushButton#shadow_color_button:pressed {
    background-color: #e2d8f8;
    border-style: solid;
}

/* ── Combo Box ──────────────────────────────────────────── */
QComboBox {
    background-color: #ffffff;
    color: #4c4f69;
    border: 1px solid #ccd0da;
    border-radius: 7px;
    padding: 5px 32px 5px 10px;
    min-width: 100px;
    selection-background-color: transparent;
}

QComboBox:hover {
    border-color: #1e66f5;
}

QComboBox:focus {
    border-color: #1e66f5;
    background-color: #f5f8ff;
}

QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: right center;
    width: 28px;
    border: none;
    border-left: 1px solid #ccd0da;
    background-color: transparent;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
}

QComboBox:hover::drop-down {
    border-left-color: #1e66f5;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #1e66f5;
    width: 0;
    height: 0;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 7px;
    color: #4c4f69;
    selection-background-color: #deeaff;
    selection-color: #1e66f5;
    padding: 4px;
    outline: none;
}

/* ── Sidebar (listWidget) ───────────────────────────────── */
QListWidget#listWidget {
    background-color: #e6e9ef;
    border: none;
    border-right: 1px solid #ccd0da;
    border-radius: 0;
    padding: 10px 0;
    outline: none;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.4px;
}

QListWidget#listWidget::item {
    color: #6c6f85;
    padding: 13px 20px;
    border-radius: 0;
    border-left: 3px solid transparent;
}

QListWidget#listWidget::item:selected {
    background-color: #ffffff;
    color: #1e66f5;
    border-left: 3px solid #1e66f5;
}

QListWidget#listWidget::item:hover:!selected {
    background-color: #dce0e8;
    color: #4c4f69;
    border-left: 3px solid #b8bccb;
}

/* ── Inner (top) tab bar — sub-tabs within Hyprland ─────── */
QTabWidget#Hyprland_Menu_Settings > QTabBar {
    background: transparent;
}

QTabWidget#Hyprland_Menu_Settings > QTabBar::tab {
    background-color: #eff1f5;
    color: #6c6f85;
    border: 1px solid #ccd0da;
    border-bottom: none;
    border-radius: 7px 7px 0 0;
    padding: 8px 20px;
    margin-right: 3px;
    font-size: 12px;
    letter-spacing: 0.3px;
}

QTabWidget#Hyprland_Menu_Settings > QTabBar::tab:selected {
    background-color: #ffffff;
    color: #1e66f5;
    border-color: #ccd0da;
    border-bottom: 2px solid #1e66f5;
}

QTabWidget#Hyprland_Menu_Settings > QTabBar::tab:hover:!selected {
    background-color: #e6e9ef;
    color: #4c4f69;
    border-color: #b8bccb;
}

QTabWidget::pane {
    background-color: #eff1f5;
    border: 1px solid #ccd0da;
    border-radius: 0 0 8px 8px;
}

/* ── Secondary tab bar (keybinds, ecosystem) ─────────────── */
QTabWidget#keybinds_tabWidget > QTabBar::tab,
QTabWidget#ecosystem_tabWidget > QTabBar::tab {
    background-color: #eff1f5;
    color: #6c6f85;
    border: 1px solid #ccd0da;
    border-bottom: none;
    border-radius: 6px 6px 0 0;
    padding: 6px 16px;
    margin-right: 3px;
    font-size: 12px;
}

QTabWidget#keybinds_tabWidget > QTabBar::tab:selected,
QTabWidget#ecosystem_tabWidget > QTabBar::tab:selected {
    background-color: #ffffff;
    color: #1e66f5;
    border-bottom: 2px solid #1e66f5;
}

QTabWidget#keybinds_tabWidget > QTabBar::tab:hover:!selected,
QTabWidget#ecosystem_tabWidget > QTabBar::tab:hover:!selected {
    background-color: #e6e9ef;
    color: #4c4f69;
}

/* ── Content List Widgets (autostart, env, wifi) ────────── */
QListWidget {
    background-color: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 8px;
    color: #4c4f69;
    padding: 4px;
    outline: none;
    font-size: 12px;
}

QListWidget::item {
    padding: 9px 12px;
    border-radius: 5px;
    color: #4c4f69;
}

QListWidget::item:selected {
    background-color: #deeaff;
    color: #1e66f5;
    border: none;
}

QListWidget::item:hover:!selected {
    background-color: #eff1f5;
    color: #4c4f69;
}

/* ── Scroll Area ────────────────────────────────────────── */
QScrollArea {
    background-color: #eff1f5;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: #eff1f5;
}

/* ── Scroll Bar ─────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    border-radius: 3px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #ccd0da;
    border-radius: 3px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #1e66f5;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    border-radius: 3px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #ccd0da;
    border-radius: 3px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: #1e66f5;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── Line Edit ──────────────────────────────────────────── */
QLineEdit {
    background-color: #ffffff;
    color: #4c4f69;
    border: 1px solid #ccd0da;
    border-radius: 7px;
    padding: 7px 10px;
    selection-background-color: #deeaff;
    selection-color: #1e66f5;
}

QLineEdit:focus {
    border-color: #1e66f5;
    background-color: #f5f8ff;
}

/* ── Check Box ──────────────────────────────────────────── */
QCheckBox {
    color: #4c4f69;
    spacing: 9px;
    font-size: 12px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1.5px solid #b8bccb;
    border-radius: 4px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #1e66f5;
    border-color: #1558d6;
    image: none;
}

QCheckBox::indicator:hover {
    border-color: #1e66f5;
    background-color: #f0f5ff;
}

QCheckBox::indicator:checked:hover {
    background-color: #1558d6;
}

/* ── Spin Box ───────────────────────────────────────────── */
QSpinBox,
QDoubleSpinBox {
    background-color: #ffffff;
    color: #4c4f69;
    border: 1px solid #ccd0da;
    border-radius: 7px;
    padding: 5px 4px 5px 8px;
}

QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: #b8bccb;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #1e66f5;
    background-color: #f5f8ff;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    background-color: #e6e9ef;
    width: 20px;
    height: 50%;
    border: none;
    border-left: 1px solid #ccd0da;
    border-bottom: 1px solid #ccd0da;
    border-top-right-radius: 6px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    background-color: #e6e9ef;
    width: 20px;
    height: 50%;
    border: none;
    border-left: 1px solid #ccd0da;
    border-bottom-right-radius: 6px;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #1e66f5;
    width: 0;
    height: 0;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #1e66f5;
    width: 0;
    height: 0;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #dce0e8;
}

/* ── Tool Tip ───────────────────────────────────────────── */
QToolTip {
    background-color: #ffffff;
    color: #4c4f69;
    border: 1px solid #ccd0da;
    border-radius: 5px;
    padding: 5px 10px;
    font-size: 12px;
}

/* ── Menu Bar ───────────────────────────────────────────── */
QMenuBar {
    background-color: #e6e9ef;
    color: #6c6f85;
    border-bottom: 1px solid #ccd0da;
    padding: 2px 8px;
    font-size: 12px;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 12px;
    border-radius: 5px;
}

QMenuBar::item:selected {
    background-color: #dce0e8;
    color: #1e66f5;
}

/* ── Dropdown Menu ──────────────────────────────────────── */
QMenu {
    background-color: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 8px;
    padding: 5px;
    color: #4c4f69;
}

QMenu::item {
    padding: 7px 22px 7px 14px;
    border-radius: 5px;
    font-size: 12px;
}

QMenu::item:selected {
    background-color: #deeaff;
    color: #1e66f5;
}

QMenu::separator {
    height: 1px;
    background: #ccd0da;
    margin: 4px 8px;
}

/* ── Group Box ──────────────────────────────────────────── */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 10px;
    margin-top: 18px;
    padding-top: 8px;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 0.8px;
    text-transform: uppercase;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 10px;
    left: 14px;
    top: 0px;
    color: #8839ef;
    background-color: #eff1f5;
    border-radius: 4px;
}

QGroupBox QLabel {
    color: #4c4f69;
    font-size: 12px;
    min-width: 110px;
    letter-spacing: 0;
}

QGroupBox QSpinBox,
QGroupBox QDoubleSpinBox {
    background-color: #eff1f5;
    min-width: 80px;
}

QGroupBox QComboBox {
    background-color: #eff1f5;
}

QGroupBox QPushButton {
    background-color: #e6e9ef;
    border-color: #b8bccb;
}

QGroupBox QPushButton:hover {
    background-color: #dce0e8;
    border-color: #1e66f5;
    color: #1558d6;
}

QGroupBox QCheckBox {
    color: #4c4f69;
    font-size: 12px;
    letter-spacing: 0;
}

/* ── Placeholder labels (coming soon tabs) ───────────────── */
QLabel#windowrules_placeholder_label,
QLabel#hyprlock_placeholder_label,
QLabel#hyprsunset_placeholder_label,
QLabel#hyprpaper_placeholder_label {
    color: #c5c8d5;
    font-size: 13px;
    letter-spacing: 0.3px;
}

/* ── Status Bar ─────────────────────────────────────────── */
QStatusBar {
    background-color: #e6e9ef;
    color: #6c6f85;
    border-top: 1px solid #ccd0da;
    font-size: 11px;
    padding: 0 10px;
}

QStatusBar::item {
    border: none;
}
