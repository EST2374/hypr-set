/* ============================================================
   Hyprset — Light Theme  (v4)
   ============================================================
   bg-base:    #f6f8fa   surface:    #ffffff
   bg-raised:  #eaeef2   border:     #d0d7de
   accent:     #0969da   accent2:    #0550ae
   text:       #1f2328   muted:      #57606a
   danger:     #cf222e   success:    #1a7f37
   ============================================================ */

/* ── Global ─────────────────────────────────────────────── */
QWidget {
    background-color: #f6f8fa;
    color: #1f2328;
    font-family: "JetBrains Mono", "Fira Code", "Cascadia Code", monospace;
    font-size: 13px;
}

QMainWindow {
    background-color: #f6f8fa;
}

/* ── Labels ─────────────────────────────────────────────── */
QLabel {
    color: #57606a;
    background: transparent;
    font-size: 12px;
    letter-spacing: 0.2px;
}

/* ── Push Buttons ───────────────────────────────────────── */
QPushButton {
    background-color: #eaeef2;
    color: #1f2328;
    border: 1px solid #d0d7de;
    border-radius: 7px;
    padding: 7px 18px;
    font-size: 13px;
    letter-spacing: 0.2px;
    outline: none;
    min-height: 30px;
}

QPushButton:hover {
    background-color: #dde1e6;
    color: #0969da;
    border-color: #0969da;
}

QPushButton:pressed {
    background-color: #0969da;
    color: #ffffff;
    border-color: #0550ae;
}

QPushButton:focus {
    border-color: #0969da;
    outline: none;
}

QPushButton:disabled {
    background-color: #f6f8fa;
    color: #8c959f;
    border-color: #d8dee4;
}

/* ── Primary / Apply button ─────────────────────────────── */
QPushButton#apply_button {
    background-color: #0969da;
    color: #ffffff;
    border: 1px solid #0550ae;
    border-radius: 7px;
    font-weight: bold;
    letter-spacing: 0.4px;
    min-height: 36px;
}

QPushButton#apply_button:hover {
    background-color: #0860ca;
    border-color: #0550ae;
}

QPushButton#apply_button:pressed {
    background-color: #0550ae;
    border-color: #033d8b;
}

/* ── Danger / Delete buttons ────────────────────────────── */
QPushButton#del_autostart_button,
QPushButton#del_env_button,
QPushButton#delete_keybind_button,
QPushButton#delete_movement_button,
QPushButton#delete_workspace_button,
QPushButton#delete_multimedia_button,
QPushButton#wifi_disconnect_button {
    background-color: #fff0ee;
    color: #cf222e;
    border-color: #ffc1c0;
    border-radius: 7px;
}

QPushButton#del_autostart_button:hover,
QPushButton#del_env_button:hover,
QPushButton#delete_keybind_button:hover,
QPushButton#delete_movement_button:hover,
QPushButton#delete_workspace_button:hover,
QPushButton#delete_multimedia_button:hover,
QPushButton#wifi_disconnect_button:hover {
    background-color: #ffe4e2;
    border-color: #cf222e;
    color: #a40e26;
}

QPushButton#del_autostart_button:pressed,
QPushButton#del_env_button:pressed,
QPushButton#delete_keybind_button:pressed,
QPushButton#delete_movement_button:pressed,
QPushButton#delete_workspace_button:pressed,
QPushButton#delete_multimedia_button:pressed,
QPushButton#wifi_disconnect_button:pressed {
    background-color: #ffc1c0;
}

/* ── Secondary action buttons (Set Default / Update) ────── */
QPushButton#set_default_look_button,
QPushButton#input_set_default_button,
QPushButton#set_default_monitor_button,
QPushButton#set_default_general_keybind_button,
QPushButton#set_default_movement_button,
QPushButton#set_default_workspace_button,
QPushButton#set_default_multimedia_button,
QPushButton#update_pushButton {
    min-width: 120px;
    min-height: 34px;
    background-color: #eaeef2;
    color: #1f2328;
    border: 1px solid #d0d7de;
    border-radius: 7px;
    font-weight: 500;
    letter-spacing: 0.3px;
    padding: 7px 18px;
}

QPushButton#set_default_look_button:hover,
QPushButton#input_set_default_button:hover,
QPushButton#set_default_monitor_button:hover,
QPushButton#set_default_general_keybind_button:hover,
QPushButton#set_default_movement_button:hover,
QPushButton#set_default_workspace_button:hover,
QPushButton#set_default_multimedia_button:hover,
QPushButton#update_pushButton:hover {
    background-color: #dde1e6;
    border-color: #0969da;
    color: #0550ae;
}

/* ── Add buttons (inline actions) ───────────────────────── */
QPushButton#general_add_button,
QPushButton#movement_add_button,
QPushButton#workspace_add_button,
QPushButton#multimedia_add_button,
QPushButton#add_program_button,
QPushButton#add_script_button,
QPushButton#add_env_button,
QPushButton#wifi_refresh_button {
    background-color: #ddf4ff;
    color: #0969da;
    border: 1px solid #b6e3ff;
    border-radius: 7px;
    font-weight: 500;
}

QPushButton#general_add_button:hover,
QPushButton#movement_add_button:hover,
QPushButton#workspace_add_button:hover,
QPushButton#multimedia_add_button:hover,
QPushButton#add_program_button:hover,
QPushButton#add_script_button:hover,
QPushButton#add_env_button:hover,
QPushButton#wifi_refresh_button:hover {
    background-color: #b6e3ff;
    border-color: #0969da;
    color: #0550ae;
}

QPushButton#general_add_button:pressed,
QPushButton#movement_add_button:pressed,
QPushButton#workspace_add_button:pressed,
QPushButton#multimedia_add_button:pressed,
QPushButton#add_program_button:pressed,
QPushButton#add_script_button:pressed,
QPushButton#add_env_button:pressed,
QPushButton#wifi_refresh_button:pressed {
    background-color: #80ccff;
    border-color: #0550ae;
}

/* ── File chooser buttons ────────────────────────────────── */
QPushButton#choose_config_file_button,
QPushButton#choose_hyprlock_button,
QPushButton#choose_hypersunset_button,
QPushButton#choose_hyperpaper_file_button,
QPushButton#choose_hypridle_button {
    background-color: #eaeef2;
    color: #1f2328;
    border: 1px solid #c8d0d8;
    border-radius: 7px;
    font-weight: 500;
    padding: 6px 16px;
    min-height: 30px;
}

QPushButton#choose_config_file_button:hover,
QPushButton#choose_hyprlock_button:hover,
QPushButton#choose_hypersunset_button:hover,
QPushButton#choose_hyperpaper_file_button:hover,
QPushButton#choose_hypridle_button:hover {
    background-color: #dde1e6;
    border-color: #0969da;
    color: #0550ae;
}

QPushButton#choose_config_file_button:pressed,
QPushButton#choose_hyprlock_button:pressed,
QPushButton#choose_hypersunset_button:pressed,
QPushButton#choose_hyperpaper_file_button:pressed,
QPushButton#choose_hypridle_button:pressed {
    background-color: #ddf4ff;
    border-color: #0550ae;
}

/* ── Success / Install / Enable buttons ─────────────────── */
QPushButton#choose_folder_button,
QPushButton#install_button,
QPushButton#enable_button {
    background-color: #dafbe1;
    color: #1a7f37;
    border: 1px solid #82cfac;
    border-radius: 7px;
    font-weight: 500;
}

QPushButton#choose_folder_button:hover,
QPushButton#install_button:hover,
QPushButton#enable_button:hover {
    background-color: #acefc3;
    border-color: #1a7f37;
    color: #116329;
}

QPushButton#choose_folder_button:pressed,
QPushButton#install_button:pressed,
QPushButton#enable_button:pressed {
    background-color: #82cfac;
    border-color: #116329;
}

/* ── Neutral-danger / Uninstall / Disable buttons ───────── */
QPushButton#uninstall_button,
QPushButton#disable_button {
    background-color: #fff0ee;
    color: #cf222e;
    border: 1px solid #ffc1c0;
    border-radius: 7px;
    font-weight: 500;
}

QPushButton#uninstall_button:hover,
QPushButton#disable_button:hover {
    background-color: #ffe4e2;
    border-color: #cf222e;
    color: #a40e26;
}

QPushButton#uninstall_button:pressed,
QPushButton#disable_button:pressed {
    background-color: #ffc1c0;
    border-color: #a40e26;
}

/* ── Color-picker buttons ───────────────────────────────── */
QPushButton#set_color_1_button,
QPushButton#set_color_2_button,
QPushButton#shadow_color_button {
    background-color: #ffffff;
    color: #0969da;
    border: 1px dashed #bbc0c6;
    border-radius: 7px;
    padding: 6px 14px;
}

QPushButton#set_color_1_button:hover,
QPushButton#set_color_2_button:hover,
QPushButton#shadow_color_button:hover {
    background-color: #eaeef2;
    border-color: #0969da;
    border-style: solid;
    color: #1f2328;
}

QPushButton#set_color_1_button:pressed,
QPushButton#set_color_2_button:pressed,
QPushButton#shadow_color_button:pressed {
    background-color: #ddf4ff;
    border-style: solid;
}

/* ── Combo Box ──────────────────────────────────────────── */
QComboBox {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #d0d7de;
    border-radius: 7px;
    padding: 5px 32px 5px 10px;
    min-width: 100px;
    selection-background-color: transparent;
}

QComboBox:hover {
    border-color: #0969da;
}

QComboBox:focus {
    border-color: #0969da;
    background-color: #f8fbff;
}

QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: right center;
    width: 28px;
    border: none;
    border-left: 1px solid #d0d7de;
    background-color: transparent;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
}

QComboBox:hover::drop-down {
    border-left-color: #0969da;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #0969da;
    width: 0;
    height: 0;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 7px;
    color: #1f2328;
    selection-background-color: #ddf4ff;
    selection-color: #0969da;
    padding: 4px;
    outline: none;
}

/* ── Sidebar (listWidget) ───────────────────────────────── */
QListWidget#listWidget {
    background-color: #eaeef2;
    border: none;
    border-right: 1px solid #d0d7de;
    border-radius: 0;
    padding: 10px 0;
    outline: none;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.4px;
}

QListWidget#listWidget::item {
    color: #57606a;
    padding: 13px 20px;
    border-radius: 0;
    border-left: 3px solid transparent;
}

QListWidget#listWidget::item:selected {
    background-color: #ffffff;
    color: #0969da;
    border-left: 3px solid #0969da;
}

QListWidget#listWidget::item:hover:!selected {
    background-color: #dde1e6;
    color: #1f2328;
    border-left: 3px solid #bbc0c6;
}

/* ── Inner (top) tab bar — sub-tabs within Hyprland ─────── */
QTabWidget#Hyprland_Menu_Settings > QTabBar {
    background: transparent;
}

QTabWidget#Hyprland_Menu_Settings > QTabBar::tab {
    background-color: #f6f8fa;
    color: #57606a;
    border: 1px solid #d0d7de;
    border-bottom: none;
    border-radius: 7px 7px 0 0;
    padding: 8px 20px;
    margin-right: 3px;
    font-size: 12px;
    letter-spacing: 0.3px;
}

QTabWidget#Hyprland_Menu_Settings > QTabBar::tab:selected {
    background-color: #ffffff;
    color: #0969da;
    border-color: #d0d7de;
    border-bottom: 2px solid #0969da;
}

QTabWidget#Hyprland_Menu_Settings > QTabBar::tab:hover:!selected {
    background-color: #eaeef2;
    color: #1f2328;
    border-color: #bbc0c6;
}

QTabWidget::pane {
    background-color: #f6f8fa;
    border: 1px solid #d0d7de;
    border-radius: 0 0 8px 8px;
}

/* ── Secondary tab bar (keybinds, ecosystem) ─────────────── */
QTabWidget#keybinds_tabWidget > QTabBar::tab,
QTabWidget#ecosystem_tabWidget > QTabBar::tab {
    background-color: #f6f8fa;
    color: #57606a;
    border: 1px solid #d0d7de;
    border-bottom: none;
    border-radius: 6px 6px 0 0;
    padding: 6px 16px;
    margin-right: 3px;
    font-size: 12px;
}

QTabWidget#keybinds_tabWidget > QTabBar::tab:selected,
QTabWidget#ecosystem_tabWidget > QTabBar::tab:selected {
    background-color: #ffffff;
    color: #0969da;
    border-bottom: 2px solid #0969da;
}

QTabWidget#keybinds_tabWidget > QTabBar::tab:hover:!selected,
QTabWidget#ecosystem_tabWidget > QTabBar::tab:hover:!selected {
    background-color: #eaeef2;
    color: #1f2328;
}

/* ── Content List Widgets (autostart, env, wifi) ────────── */
QListWidget {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 8px;
    color: #1f2328;
    padding: 4px;
    outline: none;
    font-size: 12px;
}

QListWidget::item {
    padding: 9px 12px;
    border-radius: 5px;
    color: #1f2328;
}

QListWidget::item:selected {
    background-color: #ddf4ff;
    color: #0969da;
    border: none;
}

QListWidget::item:hover:!selected {
    background-color: #eaeef2;
    color: #1f2328;
}

/* ── Scroll Area ────────────────────────────────────────── */
QScrollArea {
    background-color: #f6f8fa;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: #f6f8fa;
}

/* ── Scroll Bar ─────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    border-radius: 3px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #d0d7de;
    border-radius: 3px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #0969da;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    border-radius: 3px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #d0d7de;
    border-radius: 3px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: #0969da;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── Line Edit ──────────────────────────────────────────── */
QLineEdit {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #d0d7de;
    border-radius: 7px;
    padding: 7px 10px;
    selection-background-color: #ddf4ff;
    selection-color: #0969da;
}

QLineEdit:focus {
    border-color: #0969da;
    background-color: #f8fbff;
}

/* ── Check Box ──────────────────────────────────────────── */
QCheckBox {
    color: #1f2328;
    spacing: 9px;
    font-size: 12px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1.5px solid #bbc0c6;
    border-radius: 4px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #0969da;
    border-color: #0550ae;
    image: none;
}

QCheckBox::indicator:hover {
    border-color: #0969da;
    background-color: #f0f6ff;
}

QCheckBox::indicator:checked:hover {
    background-color: #0860ca;
}

/* ── Spin Box ───────────────────────────────────────────── */
QSpinBox,
QDoubleSpinBox {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #d0d7de;
    border-radius: 7px;
    padding: 5px 4px 5px 8px;
}

QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: #bbc0c6;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #0969da;
    background-color: #f8fbff;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    background-color: #eaeef2;
    width: 20px;
    height: 50%;
    border: none;
    border-left: 1px solid #d0d7de;
    border-bottom: 1px solid #d0d7de;
    border-top-right-radius: 6px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    background-color: #eaeef2;
    width: 20px;
    height: 50%;
    border: none;
    border-left: 1px solid #d0d7de;
    border-bottom-right-radius: 6px;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #0969da;
    width: 0;
    height: 0;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #0969da;
    width: 0;
    height: 0;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #dde1e6;
}

/* ── Tool Tip ───────────────────────────────────────────── */
QToolTip {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #d0d7de;
    border-radius: 5px;
    padding: 5px 10px;
    font-size: 12px;
}

/* ── Menu Bar ───────────────────────────────────────────── */
QMenuBar {
    background-color: #eaeef2;
    color: #57606a;
    border-bottom: 1px solid #d0d7de;
    padding: 2px 8px;
    font-size: 12px;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 12px;
    border-radius: 5px;
}

QMenuBar::item:selected {
    background-color: #dde1e6;
    color: #0969da;
}

/* ── Dropdown Menu ──────────────────────────────────────── */
QMenu {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 8px;
    padding: 5px;
    color: #1f2328;
}

QMenu::item {
    padding: 7px 22px 7px 14px;
    border-radius: 5px;
    font-size: 12px;
}

QMenu::item:selected {
    background-color: #ddf4ff;
    color: #0969da;
}

QMenu::separator {
    height: 1px;
    background: #d0d7de;
    margin: 4px 8px;
}

/* ── Group Box ──────────────────────────────────────────── */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 10px;
    margin-top: 18px;
    padding-top: 8px;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 0.8px;
    text-transform: uppercase;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 10px;
    left: 14px;
    top: 0px;
    color: #0969da;
    background-color: #f6f8fa;
    border-radius: 4px;
}

QGroupBox QLabel {
    color: #1f2328;
    font-size: 12px;
    min-width: 110px;
    letter-spacing: 0;
}

QGroupBox QSpinBox,
QGroupBox QDoubleSpinBox {
    background-color: #f6f8fa;
    min-width: 80px;
}

QGroupBox QComboBox {
    background-color: #f6f8fa;
}

QGroupBox QPushButton {
    background-color: #eaeef2;
    border-color: #bbc0c6;
}

QGroupBox QPushButton:hover {
    background-color: #dde1e6;
    border-color: #0969da;
    color: #0550ae;
}

QGroupBox QCheckBox {
    color: #1f2328;
    font-size: 12px;
    letter-spacing: 0;
}

/* ── Placeholder labels (coming soon tabs) ───────────────── */
QLabel#windowrules_placeholder_label,
QLabel#hyprlock_placeholder_label,
QLabel#hyprsunset_placeholder_label,
QLabel#hyprpaper_placeholder_label {
    color: #c8d0d8;
    font-size: 13px;
    letter-spacing: 0.3px;
}

/* ── Status Bar ─────────────────────────────────────────── */
QStatusBar {
    background-color: #eaeef2;
    color: #57606a;
    border-top: 1px solid #d0d7de;
    font-size: 11px;
    padding: 0 10px;
}

QStatusBar::item {
    border: none;
}
